{
    "name": "portfolio",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:migrate:prod": "cross-env DRIZZLE_ENV=production drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:seed": "tsx --env-file .env.local src/db/seed.ts",
        "db:seed:prod": "tsx --env-file .env.production src/db/seed.ts",
        "db:studio": "drizzle-kit studio",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "smoke:contact": "node scripts/local/contact-smoke.mjs"
    },
    "dependencies": {
        "@auth/drizzle-adapter": "^1.11.3",
        "@hookform/resolvers": "^5.9.1",
        "@vercel/analytics": "^2.0.1",
        "@vercel/blob": "^2.8.0",
        "@vercel/speed-insights": "^2.0.0",
        "botid": "^1.5.11",
        "drizzle-orm": "^0.45.2",
        "framer-motion": "^13.2.0",
        "lucide-react": "^1.46.0",
        "next": "^16.3.5",
        "next-auth": "^4.24.15",
        "postgres": "^3.4.9",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-hook-form": "^7.88.0",
        "react-icons": "^5.7.0",
        "react-phone-number-input": "^3.4.18",
        "sonner": "^2.0.8",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.5.1",
        "@types/nodemailer": "^8.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "cross-env": "^10.1.0",
        "dotenv": "^17.4.2",
        "drizzle-kit": "^0.31.10",
        "eslint": "^10.10.0",
        "eslint-config-next": "^16.3.5",
        "jsdom": "^30.0.1",
        "nodemailer": "^10.0.9",
        "prettier": "^3.9.6",
        "tailwindcss": "^4",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2",
        "vitest": "^5.0.0"
    }
}
